{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug app.ts (Node 26)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${env:HOME}/.nvm/versions/node/v26.13.0/bin/node",
      "program": "${workspaceFolder}/src/app.ts",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
