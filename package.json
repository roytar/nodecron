  },
  "engines": {
    "node": ">=26.0.0"
  },
  "dependencies": {
    "cronstrue": "^3.39.0",
    "dotenv": "^18.0.10",
    "mysql2": "^3.24.6",
    "node-cron": "^4.6.0"
  }
}
